# Hoviat - environment
# Copy to .env.local. Nothing here is public except NEXT_PUBLIC_*.

# Staging API root, including /api/sns.
SNS_API_BASE=https://staging.185.202.113.95.nip.io/api/sns

# Shared secret sent as X-Internal-Key so server-side calls skip the per-IP
# rate limiter. Leave empty until the backend implements the bypass; the header
# is simply omitted when unset. Never expose this to the browser.
SNS_INTERNAL_KEY=

# Cache window in seconds for public search results. Also the main defence
# against the 60-per-minute search limit, since one SSR host shares one IP.
SNS_SEARCH_TTL=60

# Per-request timeout in milliseconds.
SNS_TIMEOUT_MS=10000

# Set to 1 to run the whole UI against local fake data with no network at all.
SNS_USE_MOCK=0

# Telegram bot that issues login codes. Public: it is rendered as a link.
NEXT_PUBLIC_BOT_USERNAME=hoviatloginbot
