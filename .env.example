# Hoviat - environment
# Copy to .env.local. Nothing here is public except NEXT_PUBLIC_*.

# SNS API root, including /api/sns. Set to the deployed API for production.
SNS_API_BASE=http://127.0.0.1:18743/api/sns
# Optional public business API root; otherwise derived from SNS_API_BASE.
# SERVICES_API_BASE=http://127.0.0.1:18743/api/services

# Shared secret sent as X-Internal-Key so server-side calls skip the per-IP
# rate limiter. Leave empty until the backend implements the bypass; the header
# is simply omitted when unset. Never expose this to the browser.
SNS_INTERNAL_KEY=

# Legacy profile-search setting. Privacy-sensitive public reads use no-store.
SNS_SEARCH_TTL=60

# Per-request timeout in milliseconds.
SNS_TIMEOUT_MS=10000

# Legacy personal-account mock mode only. Business APIs always use real data.
# Keep 0 when using business bookmarks and owner management.
SNS_USE_MOCK=0

# Telegram bot that issues login codes. Public: it is rendered as a link.
NEXT_PUBLIC_BOT_USERNAME=hoviatloginbot

# SUPPORT CONTACTS — TODO: replace placeholders with the real public contacts.
# Used by lib/support-contacts.ts for BOTH home and My Businesses invitations.
# Telegram: https://t.me/<real_username>; phone: international format, e.g. +49...
# Leave blank to show clearly marked, non-clickable examples. Restart after edits;
# rebuild for production. These public values must never contain secrets.
NEXT_PUBLIC_SUPPORT_TELEGRAM_URL=
NEXT_PUBLIC_SUPPORT_PHONE=
